{
  "name": "mahjong-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run build -w @mahjong-together/shared && concurrently -k -n shared,server,web \"npm run dev -w @mahjong-together/shared\" \"npm run dev -w @mahjong-together/server\" \"npm run dev -w @mahjong-together/web\"",
    "build": "npm run build -w @mahjong-together/shared && npm run build -w @mahjong-together/web && npm run build -w @mahjong-together/server",
    "start": "npm run start -w @mahjong-together/server",
    "typecheck": "npm run build -w @mahjong-together/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:tablet": "playwright test --project=tablet-chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:all": "playwright test",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
